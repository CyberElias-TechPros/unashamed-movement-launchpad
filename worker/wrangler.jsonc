{
  // Cloudflare Worker backend for TTIN (The Time Is Now).
  // Database: Cloudflare D1 · Cache/rate-limit: Workers KV · Media: R2
  //
  // Canonical production deployment (Cyberelias account b7399f90…):
  //   worker   : unashamed-movement  (workers.dev /api + ttin.techpros.com.ng)
  //   D1       : unashamed-movement-db (b87763f3-2fbd-476d-9f64-a827d9ac386d)
  //   KV       : CACHE -> 4f8172c01be543e984aa74c6dfde1335
  //   R2       : MEDIA -> ttin-uploads (existing bucket, empty after migration)
  //   secrets  : JWT_SECRET, JWT_REFRESH_SECRET, CSRF_SECRET (set via wrangler secret put)
  //
  // The live DB was migrated from the older deployed schema on 2026-10-02:
  // users.password (bcrypt) -> users.password_hash (PBKDF2), order_items removed,
  // order_downloads created; preserved data reinserted from backups.
  "name": "unashamed-movement",
  "main": "src/index.ts",
  // compatibility_date/flags mirror the current production environment (nodejs_compat).
  "compatibility_date": "2025-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      // Cloudflare account: Cyberelias (b7399f904cf2b63772526dd43507f630)
      "database_id": "b87763f3-2fbd-476d-9f64-a827d9ac386d",
      "database_name": "unashamed-movement-db"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      // Cloudflare account: Cyberelias (b7399f904cf2b63772526dd43507f630)
      "id": "4f8172c01be543e984aa74c6dfde1335"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      // Cloudflare account: Cyberelias (b7399f904cf2b63772526dd43507f630)
      "bucket_name": "ttin-uploads"
    }
  ],
  "vars": {
    // Non-secret configuration. Secrets (JWT_SECRET, CSRF_SECRET, JWT_REFRESH_SECRET…)
    // are set with `wrangler secret put` or in .dev.vars for local dev.
    "CLIENT_URL": "https://ttin.techpros.com.ng",
    "ALLOWED_ORIGINS": "https://unashamed-movement-launchpad.vercel.app,https://ttin.techpros.com.ng,http://localhost:8080,http://localhost:4173",
    "EMAIL_FROM": "The Time Is Now <noreply@thetimeisnow.org>",
    "FROM_EMAIL": "noreply@thetimeisnow.org"
    // "CONTACT_NOTIFICATION_EMAIL": "team@thetimeisnow.org"  // where contact-form messages are sent
  },
  // Note: production intentionally has no cron trigger (matches deployed state;
  // the empty-shop stock-release job is omitted to preserve behavior).
  "observability": {
    "enabled": true
  }
}