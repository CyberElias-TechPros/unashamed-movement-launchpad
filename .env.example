# Frontend (Vercel) — copy to `.env` and adjust.
# Leave VITE_API_URL unset in production: /api is proxied to the Cloudflare
# Worker by vercel.json (set the CF_API_URL env var in your Vercel project).
VITE_API_URL=/api
VITE_SITE_URL=http://localhost:8080

# Google Analytics 4 (optional — leave empty to disable).
VITE_GA_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────
# The backend is the Cloudflare Worker in `worker/` (see worker/README).
# Worker secrets live in `worker/.dev.vars` (dev) or
# `npx wrangler secret put <NAME>` (production) — NOT in this file.
# MongoDB/Redis from the legacy Express server are no longer used.
