# Copy to .dev.vars for local development (git-ignored).
# In production set these with: npx wrangler secret put <NAME>
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
CSRF_SECRET=change_this_to_csrf_secret
CLIENT_URL=http://localhost:8080
# Optional integrations:
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_HASH=
