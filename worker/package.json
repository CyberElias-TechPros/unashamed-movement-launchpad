{
  "name": "ttin-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc",
    "db:schema:local": "wrangler d1 execute ttin-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute ttin-db --local --file=./seed.sql",
    "db:schema:remote": "wrangler d1 execute ttin-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute ttin-db --remote --file=./seed.sql",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "hono": "^4.10.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251110.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.50.0"
  }
}
